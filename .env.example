# EmailJS — GuestBook "Share Your Thoughts" page
# Sign up at https://www.emailjs.com, create a service + template, then fill these in.
# Copy this file to .env.local and add your real values.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# EmailJS template variables used:
#   {{from_name}}  — sender's name (or "An anonymous traveller")
#   {{message}}    — the message body
